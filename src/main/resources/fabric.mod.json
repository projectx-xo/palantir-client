{
  "schemaVersion": 1,
  "id": "palantir",
  "version": "${version}",
  "name": "Palantir Client",
  "description": "Client-side tracker that detects which players are currently in the same shard by reading the multiplayer tab list, and shows them through a configurable HUD and corner notifications.",
  "authors": [
    "Palantir Client Contributors"
  ],
  "license": "MIT",
  "icon": "assets/palantir/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.perplexddev.palantir.PalantirMod"
    ],
    "modmenu": [
      "com.perplexddev.palantir.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.18.2",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config2": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
