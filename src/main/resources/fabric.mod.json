{
  "schemaVersion": 1,
  "id": "shardtracker",
  "version": "${version}",
  "name": "Shard Tracker",
  "description": "Client-side tracker that detects which players are currently in the same shard by reading the multiplayer tab list, and shows them through a configurable HUD and corner notifications.",
  "authors": [
    "Shard Tracker Contributors"
  ],
  "license": "MIT",
  "icon": "assets/shardtracker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.perplexddev.shardtracker.ShardTrackerMod"
    ],
    "modmenu": [
      "com.perplexddev.shardtracker.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": "~1.18.2",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config2": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
